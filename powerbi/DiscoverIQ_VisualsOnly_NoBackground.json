{
  "name": "DiscoverIQ Visuals Only - Blue Purple",
  "dataColors": [
    "#005BFF",
    "#8B2CFF",
    "#00A3FF",
    "#22C55E",
    "#F97316",
    "#EF4444",
    "#14B8A6",
    "#F59E0B",
    "#64748B"
  ],
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "color": "#0F172A"
    },
    "label": {
      "fontFace": "Segoe UI",
      "color": "#334155"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "color": "#0F172A"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#0F172A" } },
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "background": [
          {
            "show": false,
            "transparency": 100
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "visualHeader": [
          {
            "show": true,
            "foreground": { "solid": { "color": "#64748B" } }
          }
        ],
        "legend": [
          {
            "show": true,
            "labelColor": { "solid": { "color": "#334155" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "labelColor": { "solid": { "color": "#475569" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI",
            "gridlineColor": { "solid": { "color": "#E5E7EB" } }
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "labelColor": { "solid": { "color": "#475569" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI",
            "gridlineColor": { "solid": { "color": "#E5E7EB" } }
          }
        ],
        "dataPoint": [
          {
            "defaultColor": { "solid": { "color": "#005BFF" } }
          }
        ],
        "labels": [
          {
            "color": { "solid": { "color": "#334155" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ],
        "dataLabel": [
          {
            "show": true,
            "color": { "solid": { "color": "#0F172A" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "card": {
      "*": {
        "categoryLabels": [
          {
            "show": true,
            "color": { "solid": { "color": "#64748B" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ],
        "labels": [
          {
            "color": { "solid": { "color": "#0F172A" } },
            "fontSize": 22,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "background": [
          {
            "show": false,
            "transparency": 100
          }
        ]
      }
    },
    "multiRowCard": {
      "*": {
        "categoryLabels": [
          {
            "color": { "solid": { "color": "#64748B" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ],
        "dataLabels": [
          {
            "color": { "solid": { "color": "#0F172A" } },
            "fontSize": 18,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "background": [
          {
            "show": false,
            "transparency": 100
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "items": [
          {
            "fontColor": { "solid": { "color": "#0F172A" } },
            "background": { "solid": { "color": "#FFFFFF" } },
            "outline": "#CBD5E1",
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ],
        "header": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#334155" } },
            "background": { "solid": { "color": "#FFFFFF" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "background": [
          {
            "show": false,
            "transparency": 100
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": { "solid": { "color": "#E5E7EB" } }
          }
        ],
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#0F172A" } },
            "backColor": { "solid": { "color": "#F8FAFC" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "values": [
          {
            "fontColorPrimary": { "solid": { "color": "#334155" } },
            "backColorPrimary": { "solid": { "color": "#FFFFFF" } },
            "backColorSecondary": { "solid": { "color": "#F8FAFC" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ],
        "background": [
          {
            "show": false,
            "transparency": 100
          }
        ]
      }
    },
    "matrix": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": { "solid": { "color": "#E5E7EB" } }
          }
        ],
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#0F172A" } },
            "backColor": { "solid": { "color": "#F8FAFC" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "values": [
          {
            "fontColorPrimary": { "solid": { "color": "#334155" } },
            "backColorPrimary": { "solid": { "color": "#FFFFFF" } },
            "backColorSecondary": { "solid": { "color": "#F8FAFC" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ],
        "background": [
          {
            "show": false,
            "transparency": 100
          }
        ]
      }
    }
  }
}
